<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:NarutoBattle"
             x:Class="NarutoBattle.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared colors and styles so every page looks the same -->
            <Color x:Key="DarkBg">#1A1A2E</Color>
            <Color x:Key="CardBg">#16213E</Color>
            <Color x:Key="NinjaOrange">#FF7A00</Color>

            <Style x:Key="HeadingLabel" TargetType="Label">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource NinjaOrange}" />
            </Style>

            <Style x:Key="MenuButton" TargetType="Button">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="HeightRequest" Value="55" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="BackgroundColor" Value="{StaticResource NinjaOrange}" />
                <Setter Property="TextColor" Value="#1A1A2E" />
                <Setter Property="HorizontalOptions" Value="Fill" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
